name: Build BountyHunt Plugin

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Download PaperMC API
        run: |
          wget https://repo.papermc.io/repository/maven-public/io/papermc/paper/paper-api/1.26.2-R0.1-SNAPSHOT/paper-api-1.26.2-R0.1-SNAPSHOT.jar -O paper-api.jar
          mvn install:install-file -Dfile=paper-api.jar -DgroupId=io.papermc.paper -DartifactId=paper-api -Dversion=1.26.2-R0.1-SNAPSHOT -Dpackaging=jar

      - name: Build with Maven
        run: mvn clean package

      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: BountyHuntPlugin
          path: target/BountyHunt-1.0.jar
